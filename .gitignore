# =============================================================================
# .gitignore — Projeto React + Vite (Redesign Caixa de Autoatendimento - IHC)
# =============================================================================

# Dependências
node_modules/
.pnp
.pnp.js
.yarn/

# Build de produção e cache do Vite
dist/
dist-ssr/
build/
.vite/
*.local

# Variáveis de ambiente e segredos (NUNCA versionar)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key

# Logs e diagnósticos
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura de testes
coverage/
.nyc_output/

# Editores, IDEs e configurações locais de agentes
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.agents/

# Arquivos temporários do Sistema Operacional
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
